# PORT: The port the server listens on (defaults to 3000, dynamically provided on Google Cloud Run)
PORT=3000

# APP_URL: The URL where this application is hosted
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls (optional for rule-based engine)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
